[req]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = req_ext
x509_extensions    = v3_ca

[dn]
C  = CA
ST = ON
L  = Ottawa
O  = DTA
OU = MRSE
CN = 192.168.0.105

[req_ext]
subjectAltName = @alt_names

[v3_ca]
subjectAltName = @alt_names
basicConstraints = CA:true

[alt_names]
IP.1 = 192.168.0.105
